<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <EditText
            android:id="@+id/inputFullName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Full Name" />

        <EditText
            android:id="@+id/inputBloodGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Blood Group" />

        <EditText
            android:id="@+id/inputAllergies"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Allergies (comma separated)" />

        <EditText
            android:id="@+id/inputChronicIllnesses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Chronic Illnesses (comma separated)" />

        <EditText
            android:id="@+id/inputMedications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Medications (comma separated)" />

        <TextView
            android:id="@+id/textVerifiedResponderStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Verification Status" />

        <View
            android:id="@+id/badgePhoneVerified"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="#00FF00"
            android:visibility="gone" />

        <View
            android:id="@+id/badgeIdVerified"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="#00FF00"
            android:visibility="gone" />

        <View
            android:id="@+id/badgeFaceVerified"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="#00FF00"
            android:visibility="gone" />

        <Button
            android:id="@+id/buttonVerifyId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Verify ID" />

        <Button
            android:id="@+id/buttonVerifySelfie"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Verify Selfie" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Emergency Contacts"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/emergencyContactsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/buttonAddEmergencyContact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Emergency Contact" />

        <Button
            android:id="@+id/buttonSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Save" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
